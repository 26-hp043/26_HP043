# .env.db.example -- db-01 호스트 (CUBRID만).
# db-01에서 .env로 복사한 뒤 실제 값을 채운다.
#
# 사용법:
#   cp .env.db.example .env
#   docker compose -f docker-compose.prod.db.yml up -d

# ----- CUBRID -----
# CUBRID 11.4 제한: ASCII 문자열, 최대 31바이트. 싱글쿼트 포함 금지.
CUBRID_PASSWORD=

# ----- 포트 게시 (#1641) -----
# db-01 자신의 VCN 사설 IP. docker-compose.prod.db.yml이 CUBRID 포트를 이 주소에만
# 붙인다(`${OCI_DB_PRIVATE_IP}:33100:33000`) — 공용 인터페이스에는 소켓이 열리지 않는다.
# 비우면 compose가 기동을 거부한다(비면 모든 인터페이스로 열리기 때문).
# 자동 배포는 같은 이름의 GitHub 시크릿에서 렌더한다(docs/OPERATIONS.md §5.1).
OCI_DB_PRIVATE_IP=
