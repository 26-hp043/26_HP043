# .env.app.example -- app-01 호스트 (backend + migrate).
# app-01에서 .env로 복사한 뒤 실제 값을 채운다.
#
# 사용법:
#   cp .env.app.example .env
#   docker compose -f docker-compose.prod.app.yml up -d

# ----- CUBRID 연결 (크로스 VM) -----
# db-01의 VCN 사설 IP. 절대 공용 IP를 쓰지 않는다.
CUBRID_HOST=
# db-01의 CUBRID_PASSWORD와 동일해야 한다.
# CUBRID 11.4 제한: ASCII 문자열, 최대 31바이트.
CUBRID_PASSWORD=
# 완성된 접속 URL (#2118). 주석을 풀지 않으면 compose가 위 두 값으로
# cubrid+pycubrid://dba:<CUBRID_PASSWORD>@<CUBRID_HOST>:33100/cii 를 조립한다
# (docker-compose.prod.app.yml의 x-cubrid-url). 그 조립은 비밀번호를 URL 인코딩하지 않는다 —
# 비밀번호에 `@`·`%` 같은 URL 예약 문자가 있으면 주석을 풀고 인코딩한 값으로 직접 적는다.
# 자동 배포는 언제나 인코딩한 URL을 적는다(deploy.yml의 .env 렌더).
# DATABASE_URL=cubrid+pycubrid://dba:<URL 인코딩한 비밀번호>@<db-01 사설 IP>:33100/cii

# ----- 환경 구분 (#2118) -----
# 허용값: development · test · staging · production (src/cii_platform/config.py).
# 주석을 풀지 않으면 compose 기본값 production으로 뜬다(`${APP_ENV:-production}`).
# production은 아래 가입 게이트·최초 관리자가 비면 기동이 실패한다(각 절의 주석).
# 자동 배포는 APP_ENV 시크릿이 없으면 staging을 적는다(deploy.yml · docs/OPERATIONS.md §3.3 · §4.5).
# APP_ENV=staging

# ----- 백엔드 -----
# Cloudflare Pages 등 프론트엔드 오리진. 쉼표 구분.
CORS_ALLOW_ORIGINS=
# 메일 링크 기준 주소 (프론트엔드 공개 URL).
APP_PUBLIC_URL=

# ----- 컨테이너 이미지 (deploy 워크플로가 설정, 기본값 latest) -----
BACKEND_IMAGE=ghcr.io/26-hp043/bluelog-backend:latest

# ----- 가입 게이트 -----
# 둘 중 하나만 맞으면 가입된다. production에서 둘 다 비면 기동 실패.
SIGNUP_ALLOWED_DOMAINS=
SIGNUP_INVITE_CODE=

# ----- 둘러보기 접근 코드 (#1486) -----
# 가입 없이 서비스를 보여 주는 링크(/login?tour=<코드>)의 잠금.
# **비워 두면 닫힌다**(fail-closed). 인터뷰가 끝나면 비운다.
TOUR_ACCESS_CODE=
# 코드 없이 둘러보기를 여는 스위치 (#1486 후속) — true일 때만. 읽기 전용은 그대로 유지된다.
TOUR_PUBLIC=

# ----- 최초 관리자 (#672 · #1301) -----
# 쉼표로 나눈 이메일. 여기 든 주소는 가입·로그인할 때마다 관리자(ADMIN)로 맞춰진다.
# 새 계정은 현장직으로 시작하고 역할을 바꾸는 일은 관리자만 할 수 있으므로, **비워 두면
# 새 DB는 관리자 0명으로 뜨고 화면으로는 아무도 역할을 올릴 수 없다** (#1290 · #1301).
# production에서 비면 기동 실패. staging에는 그 가드가 없으니 여기서 반드시 채운다.
# ⚠️ 옛 이름 INITIAL_OFFICE_EMAILS는 읽히지 않는다 — 설정돼 있으면 기동이 실패한다 (#1301).
INITIAL_ADMIN_EMAILS=

# ----- 메일 -----
MAIL_BACKEND=smtp
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ----- 챗봇 LLM -----
# 비우거나 `-`면 챗봇만 꺼진다. 아래 셋은 비우면 Anthropic 기본값 (#1535 · .env.example)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_AUTH_SCHEME=

# ----- 요청 한도 · 프록시 서명 헤더 (#1483) -----
# Pages Function 프록시와 나눠 가진 비밀 값. 맞을 때만 프록시가 실은 원 IP로 센다.
# 비우면 전원이 터널 주소 하나로 보여 로그인 10회/분을 나눠 쓴다.
PROXY_CLIENT_IP_SECRET=
# ----- 공공데이터 재항 기록 (#1197) -----
# 공공데이터포털 인증키(해양수산부 선박운항정보). 비우면 수집 경로만 꺼진다.
DATA_GO_KR_SERVICE_KEY=

# ----- Cloudflare Tunnel 커넥터 토큰 (#1496) -----
# 현재 운영은 **비워 둔다** — 커넥터는 app-01의 systemd cloudflared가 이미 제공한다
# (docs/OPERATIONS.md §3.5). compose의 cloudflared 서비스는 tunnel 프로필 뒤에 있어
# `--profile tunnel`을 줄 때만 뜨고, 그때 이 값을 읽는다. 값을 넣고 그 프로필로 띄우면
# 같은 터널에 커넥터가 둘이 된다.
CLOUDFLARE_TUNNEL_TOKEN=
