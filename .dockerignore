# 빌드 컨텍스트에서 불필요한 파일을 제외해 빌드 속도를 높인다.

# Git
.git
.gitignore

# Python 캐시/빌드 산출물
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/

# Testing
.coverage
htmlcov/
.pytest_cache/
tests/

# Environment (비밀값 이미지 유입 방지)
.env

# 실행 로그 (#827)
#
# 빌드 컨텍스트로 들어가고 있었다. 이 로그에는 **인증 토큰이 쿼리 문자열째 남는다**
# (`verify-email?token=...` 등 4건 확인) — 이미지에 실리면 그 이미지를 받을 수 있는
# 누구에게나 남는다. 빌드 속도 문제가 아니라 비밀값 유입 문제라 `.env` 옆에 둔다.
logs/
*.log

# DB 백업 덤프 (#827) — 운영 데이터 전부가 들어 있다. 이미지에 실리면 그 이미지를 받는
# 누구에게나 계정·비밀번호 해시까지 넘어간다.
backups/

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# 문서 (이미지 빌드에 불필요)
*.md

# 잠금 파일 (pip install -e . 는 pyproject 기준)
uv.lock

# Docker 관련 파일
Dockerfile
docker-compose.yml
docker-compose.prod.yml
.dockerignore
