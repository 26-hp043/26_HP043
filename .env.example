# 이 파일은 본보기다. 실제 값은 `.env`에 두며 그 파일은 git이 무시한다.
#
# 어떻게 읽히는가 (#508)
#   호스트 실행   uvicorn --env-file .env ...       → 프로세스 환경으로 들어간다
#   docker compose                                  → 두 경로가 **다르다**
#     · 이 파일 안의 ${POSTGRES_USER} 같은 치환      ← compose가 .env를 읽어 채운다
#     · 컨테이너 안의 환경변수                        ← `env_file:`이 있어야 들어간다
#
#   종전에는 뒤쪽이 없어 컨테이너에 DATABASE_URL 하나만 들어갔고, MAIL_BACKEND가
#   비어 mail/config.py의 기본값 `console`이 적용됐다 — 메일이 조용히 로그로만 나갔다.

# PostgreSQL credential — docker-compose.yml(개발)은 미설정 시 cii 기본값을 사용.
# docker-compose.prod.yml(프로덕션)은 미설정 시 즉시 실패한다 (#85).
POSTGRES_USER=cii
POSTGRES_PASSWORD=cii
POSTGRES_DB=cii

DATABASE_URL=postgresql+asyncpg://cii:cii@localhost:5432/cii

# 환경 구분. production이면 DATABASE_URL 누락 시 즉시 실패한다.
# 미설정 시 development로 본다.
#
# 허용값은 넷뿐이다: development · test · staging · production (#810).
#   - 대소문자·앞뒤 공백은 정규화한다 — `Production`·`"production "`도 production이다.
#   - **그 밖의 값이면 앱이 뜨지 않는다.** `prod` 같은 약어를 development로 취급하면
#     dev-login · /docs · 데모 계정 시드 · DB URL 폴백 · console 메일 백엔드가
#     프로덕션에서 **함께, 조용히** 열린다(앱은 정상 기동하고 /health도 200이다).
#
# ⚠️ **주석을 풀지 않는다 (#810).** 개발에는 필요 없다 — 미설정이 곧 development이고
#   `docker-compose.yml`(개발 스택)은 이 변수를 아예 넘기지 않는다. 반면 이 파일을
#   그대로 `.env`로 복사하면 **프로덕션 스택이 development로 뜬다**:
#   `docker-compose.prod.yml`의 `APP_ENV: ${APP_ENV:-production}`은 셸에 값이 없으면
#   **`.env`에서 읽고**, 그 값이 이미지에 굳은 `ENV APP_ENV=production`(Dockerfile:85)을
#   덮는다. `#524`가 요구하는 SMTP 설정 때문에 운영 호스트에도 `.env`가 생기므로
#   가정이 아니라 기본 경로다 — 실제로 이 저장소의 `.env`로 prod 스택을 띄우면
#   `APP_ENV=development`가 나온다(README 배포 확인 표 첫 행이 그것을 잡는다).
#
#   개발 모드로 prod 스택을 띄워 배포 배선만 확인할 때는 셸에서 준다 (README 참조):
#     APP_ENV=development docker compose -f docker-compose.prod.yml up -d
# APP_ENV=development

# 메일 링크의 기준 주소 (#429).
#
# /verify-email · /password-reset은 **프론트엔드 라우트**다 — API 서버에는 그 경로가
# 없다. 미설정 시 요청의 base URL을 쓴다.
#
# ⚠️ 운영(APP_ENV=production): **반드시 설정한다. 없으면 앱이 뜨지 않는다** (#809).
#   미설정 시 링크가 요청의 Host 헤더를 따라가므로, 공격자가 그 헤더를 바꿔 요청하면
#   피해자는 **정상 발신지에서 온 정상 문구의 메일**을 받는데 링크만 공격자 도메인이다.
#   클릭 한 번에 유효한 재설정 토큰(1시간)·인증 토큰(24시간)이 넘어간다.
#   종전 문구는 「운영에서도 설정하지 않아도 된다」였다 — 권장 설정이 곧 취약 설정이었다.
# 개발(Vite 5173 / FastAPI 8000): 아래처럼 프론트엔드 주소를 명시해야 한다.
#   설정하지 않으면 메일 링크가 8000번을 가리켜 인증 화면이 뜨지 않는다.
APP_PUBLIC_URL=http://localhost:5173

# 가입 게이트 (#808) — 누가 계정을 만들 수 있는가.
#
# 이 제품은 사내 도구다. 권한 분리·데이터 격리가 없어 로그인한 사용자는 모든
# 선박·항차를 고칠 수 있으므로, 들어오는 문을 좁힌다. 둘 중 하나만 맞으면 가입된다.
#
# SIGNUP_ALLOWED_DOMAINS — 쉼표로 나눈 회사 메일 도메인 (예: bluelog.kr,partner.co.kr)
# SIGNUP_INVITE_CODE     — 회사 메일이 아닌 사람(협력사·시연 참석자)에게 따로 알려 줄 코드.
#                          16자 이상을 권한다 — 가입 경로는 IP당 분당 10회로 제한된다(#811).
#
# ⚠️ APP_ENV=production인데 둘 다 비어 있으면 기동이 실패한다 (`api/main.py` lifespan).
#    개발·테스트에서는 비워 두면 가입이 열려 있다. 실제 값은 커밋하지 않는다.
# SIGNUP_ALLOWED_DOMAINS=
# SIGNUP_INVITE_CODE=

# 메일 발송 (#407) — 가입 확인·비밀번호 재설정 메일.
#
# console: 메일을 실제로 보내지 않고 로그로만 출력한다. 개발자가 SMTP 자격증명
#          없이도 전체 플로우를 돌릴 수 있게 하기 위한 기본값이다.
# smtp   : 실제 발송.
#
# ⚠️ APP_ENV=production + MAIL_BACKEND=console 조합은 기동이 실패한다.
#    `api/main.py`의 lifespan이 기동 시점에 검증한다 (#524). 연결은 열지 않으므로
#    SMTP 서버가 떠 있지 않아도 설정만 맞으면 기동한다.
#    운영에서 재설정 메일이 로그로만 나가면 사용자가 계정을 잃는데,
#    그 실패는 조용해서 문의가 올 때까지 드러나지 않는다.
MAIL_BACKEND=console
MAIL_FROM=BlueLog <no-reply@localhost>

# MAIL_BACKEND=smtp일 때만 필요. 실제 값은 커밋하지 않는다.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-account@gmail.com
# SMTP_PASSWORD=your-app-password
#
# SMTP_USE_TLS — 미설정이면 true. 587(STARTTLS)에서는 켠 채로 둔다.
# ⚠️ 허용값은 아래 여덟 개뿐이고, **그 밖의 값은 서버가 뜨지 않는다** (#868).
#    참: 1 / true / yes / on     거짓: 0 / false / no / off
#    종전에는 모르는 값(enabled·Y·TLS 등)이 조용히 「끔」이 되어 자격증명과
#    비밀번호 재설정 링크가 평문으로 나갔다 — 메일은 정상 도착해 드러나지 않는다.
# SMTP_USE_TLS=true

# 요청 한도 — 경로 버킷별 분당 한도 (#238 · #811). 각 값이 0이면 그 버킷만 비활성.
#
# 버킷은 서로 독립이다(카운터 키가 `(버킷, IP)`). 인증 한도를 다 써도 CRUD·계산은
# 막히지 않는다 — 한 IP의 분당 상한은 세 값의 합(기본 370)이다.

# CRUD API — API_SPEC §13.2. 버킷에 안 잡히는 나머지 전부가 여기로 온다.
RATE_LIMIT_PER_MINUTE=300

# 인증 API — /auth/login · /signup · /password-change · /password-reset/request ·
# /verify-email/request. 로그인 무차별 대입과 **메일 발송 증폭**을 막는다 (#811).
RATE_LIMIT_AUTH_PER_MINUTE=10

# 계산 API — API_SPEC §13.2. /calculations/voyage-cii · /scenarios/compare ·
# /annual-simulations(+/reproduce). 요청당 CPU가 CRUD보다 크다.
RATE_LIMIT_CALC_PER_MINUTE=60

# X-Forwarded-For 신뢰 여부 (#rate-limit-security).
# 역방향 프록시 뒤에서만 true로 설정.
USE_FORWARDED_FOR=false